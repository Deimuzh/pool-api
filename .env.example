# Configuración de la API de Piscina.
# Copia este archivo a .env si quieres ejecutar la app con variables locales.

# Puerto HTTP.
PUERTO=:8080

# Motor de base de datos: sqlite para desarrollo local o postgres para Docker/producción.
DB_DRIVER=sqlite

# DSN de PostgreSQL. Solo se usa cuando DB_DRIVER=postgres.
# Ejemplo local:
# DB_DSN=host=localhost user=piscina password=piscina123 dbname=piscina port=5432 sslmode=disable
DB_DSN=

# Archivo SQLite. Solo se usa cuando DB_DRIVER=sqlite.
RUTA_DB=piscina.db

# Clave para firmar JWT. En producción debe ser larga, aleatoria y privada.
JWT_SECRETO=cambia-esto-por-un-secreto-largo-y-unico

# Duración del token JWT.
JWT_DURACION=24h

# Timeouts del servidor HTTP.
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=10s
